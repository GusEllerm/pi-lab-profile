{
  "name": "pi-lab-profile",
  "version": "0.1.0",
  "description": "A Pi profile: right-hand status column, an interactive subagent fleet you can attach to, dev \u2192 review \u2192 critique rounds across separate inference endpoints, Argo and ALCF as providers, and an enforced spend gate for hpc-bridge.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GusEllerm/pi-lab-profile.git"
  },
  "files": [
    "extensions",
    "agents",
    "profiles",
    "skills",
    "scripts",
    "docs",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/statusbar.ts",
      "./extensions/fleet.ts",
      "./extensions/rounds.ts",
      "./extensions/endpoints.ts",
      "./extensions/code-panels.ts",
      "./extensions/image-window.ts",
      "./extensions/outputs.ts",
      "./extensions/paste-guard.ts",
      "./extensions/liveness.ts",
      "./extensions/hpc-bridge.ts",
      "./extensions/argo.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.0",
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0"
  },
  "scripts": {
    "check": "bash scripts/check.sh",
    "test": "node --test tests/*.test.ts tests/*.test.mjs"
  }
}
